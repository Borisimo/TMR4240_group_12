        put(f"{tag}c_rms_psi", np.rad2deg(rms(psi_err(ll)))); put(f"{tag}c_max_psi", np.rad2deg(psi_err(ll).max()))
        r = ll.tau_d - ll.tau_thr; put(f"{tag}c_res_rms", rms(r[:, :2]) / 1e3)
    # velocity noise seen by the controller (raw feedback uses the simulated velocity)
    dt = DT
    put("s3_acc_rms_cmd", rms(np.diff(l.tau_d[:, 0]) / dt) / 1e3)
    for nm, v in constraint_report(l).items():
        put(f"s3_{nm}_atmax", 100 * v[0], "{:.1f}"); put(f"s3_{nm}_atrate", 100 * v[1], "{:.1f}")
    return l


def sim4():
    fixed = rc.WrenchSequence([(1.0, [2e3, 2e3, 2e3])])
    W = sel  # alias
    res = {}
    names = {"nonlinear_passive": "npo", "kalman": "ekf"}
    for kind in names:
        for label, wv in (("waves", True), ("nowaves", False)):
            cfg = Part2SimConfig(dt=DT, T=600.0, use_reference=False, use_observer=True, observer_type=kind)
            l = rc.run(cfg, np.zeros(6), env(waves=wv), controller=fixed)
            res[(kind, label)] = l
            save(plot_observer(l), f"p2_sim4_{names[kind]}_{label}.png")
            save(plot_observer_error(l), f"p2_sim4_{names[kind]}_{label}_err.png")
            e = est_errors(l, sel(l, 300.0))
            for k, v in e.items(): put(f"s4_{names[kind]}_{label}_{k}", v, "{:.3f}")
    # stage 2: convergence from offset (run in the design sea with waves)
    for kind in names:
        cfg = Part2SimConfig(dt=DT, T=300.0, use_reference=False, use_observer=True, observer_type=kind)
        sim = rc.make_sim(cfg, fixed); sim.reset_state(); sim.observer.reset(rc.OBSERVER_OFFSET)
        cur, wnd, wav = env()
        l = sim.run(np.zeros(6), current=cur, wind=wnd, waves=wav)
        res[(kind, "offset")] = l
        save(plot_observer_error(l), f"p2_sim4_{names[kind]}_offset_err.png")
        lf = low_frequency_motion(l, 30.0)
        e = np.hypot(l.eta_est[:, 0] - l.eta[:, 0], l.eta_est[:, 1] - l.eta[:, 1])
        # first time after which the position error stays below 1 m / the heading error below 1 deg
        def settle(x, lim):
            bad = np.where(x > lim)[0]
            return float(l.t[bad[-1] + 1]) if bad.size and bad[-1] + 1 < len(l.t) else (0.0 if not bad.size else float("nan"))
        put(f"s4_{names[kind]}_conv_pos", settle(e, 1.0), "{:.0f}")
        ep = np.abs((l.eta_est[:, 5] - l.eta[:, 5] + np.pi) % (2 * np.pi) - np.pi)
        put(f"s4_{names[kind]}_conv_psi", settle(np.rad2deg(ep), 1.0), "{:.0f}")
    # combined comparison figure
    f, ax = plt.subplots(3, 1, figsize=(9, 8), sharex=True)
    for (kind, c) in zip(names, ("C1", "C2")):
        l = res[(kind, "waves")]
        for a, (yl, i) in zip(ax, [("N [m]", 0), ("E [m]", 1), ("$\\psi$ [deg]", 5)]):
            sc = np.rad2deg(1) if i == 5 else 1
            a.plot(l.t, l.eta_est[:, i] * sc, color=c, label=f"estimate {names[kind].upper()}")
    l = res[("kalman", "waves")]
    for a, (yl, i) in zip(ax, [("N [m]", 0), ("E [m]", 1), ("$\\psi$ [deg]", 5)]):
        sc = np.rad2deg(1) if i == 5 else 1
        a.plot(l.t, l.eta_measured[:, i] * sc, color="0.6", lw=.6, label="measured/true pose")
        a.plot(l.t, low_frequency_motion(l, 30.0)[:, [0, 1, 2][[0, 1, 5].index(i)]] * sc, "k--", label="LF truth (30 s mean)")
        a.set_ylabel(yl); a.grid(alpha=.3)
    ax[0].legend(ncol=2, fontsize=8); ax[-1].set_xlabel("time [s]"); f.tight_layout(); save(f, "p2_sim4_stage1.png")
    # stage 3: closed loop hold origin, raw vs both observers
    cl = {}
    for label, use, kind in (("raw", False, rc.selected_observer()), ("npo", True, "nonlinear_passive"), ("ekf", True, "kalman")):
        cfg = Part2SimConfig(dt=DT, T=600.0, use_observer=use, observer_type=kind)
        l = rc.run(cfg, np.zeros(6), env()); cl[label] = l
        s = sel(l, 300.0)
        put(f"s4c_{label}_rms_pos", rms(pos_err(l)[s])); put(f"s4c_{label}_max_pos", pos_err(l)[s].max())
        put(f"s4c_{label}_rms_psi", np.rad2deg(rms(psi_err(l)[s])))
        for k, v in activity(l, s).items(): put(f"s4c_{label}_{k}", v)
    f, ax = plt.subplots(3, 1, figsize=(9, 8), sharex=True)
    for lab, c in (("raw", "C0"), ("npo", "C1"), ("ekf", "C2")):
        l = cl[lab]
        ax[0].plot(l.t, pos_err(l), color=c, label=lab.upper() if lab != "raw" else "raw feedback")
        ax[1].plot(l.t, np.rad2deg(l.eta[:, 5]), color=c)
        ax[2].plot(l.t, np.sum(np.abs(l.u), axis=1) / 1e3, color=c, lw=.8)
    ax[0].set_ylabel("position error [m]"); ax[1].set_ylabel("heading [deg]"); ax[2].set_ylabel("$\\sum|u_i|$ [kN]")
    ax[0].legend(); ax[-1].set_xlabel("time [s]")
    for a in ax: a.grid(alpha=.3)
    f.tight_layout(); save(f, "p2_sim4_stage3.png")
    # convergence figure
    f, ax = plt.subplots(2, 1, figsize=(8, 5), sharex=True)
    for kind, c in zip(names, ("C1", "C2")):
        l = res[(kind, "offset")]
        ax[0].plot(l.t, np.hypot(l.eta_est[:, 0] - l.eta[:, 0], l.eta_est[:, 1] - l.eta[:, 1]), color=c, label=names[kind].upper())
        ax[1].plot(l.t, np.rad2deg(np.abs((l.eta_est[:, 5] - l.eta[:, 5] + np.pi) % (2 * np.pi) - np.pi)), color=c)
    ax[0].set_ylabel("position error [m]"); ax[1].set_ylabel("heading error [deg]"); ax[1].set_xlabel("time [s]")
    ax[0].legend(); [a.grid(alpha=.3) for a in ax]; f.tight_layout(); save(f, "p2_sim4_stage2.png")
    return res, cl


def sim5(step_deg=10.0):
    def run_direction(d):
        cfg = Part2SimConfig(dt=DT, T=600.0, use_observer=True, observer_type=rc.selected_observer())
        e = (rc.Current(rc.CAP_CURRENT, d, semantics="from"),
             rc.Wind(rc.CAP_WIND, d, semantics="from", sigma_slow=0.5, gust=True, sigma_dir=np.deg2rad(2.0), seed=rc.SEED),
             rc.Waves(hs=rc.CAP_HS, tp=rc.CAP_TP, direction=d, seed=rc.SEED))
        return rc.run(cfg, np.zeros(6), e)
    r = capability_sweep(run_direction, TH, step_deg=step_deg, pos_limit=rc.CAP_POS_LIMIT,
                         psi_limit_deg=rc.CAP_PSI_LIMIT_DEG, deviation="lf", keep_logs=False, verbose=False)
    save(plot_capability(r, total_limits=(rc.CAP_TOTAL_POS_LIMIT, rc.CAP_TOTAL_PSI_LIMIT_DEG)), "p2_sim5_polar.png")
    ok_lf = r.feasible; ok_tot = (r.max_pos_dev_total <= rc.CAP_TOTAL_POS_LIMIT) & (r.max_psi_dev_total <= np.deg2rad(rc.CAP_TOTAL_PSI_LIMIT_DEG))
    rows = []
    for d, u, pl, ql, pt, qt, a, b in zip(r.directions_deg, r.utilization, r.max_pos_dev_lf, r.max_psi_dev_lf,
                                           r.max_pos_dev_total, r.max_psi_dev_total, ok_lf, ok_tot):
        rows.append(f"{d:.0f} & {u:.1f} & {pl:.2f} & {np.rad2deg(ql):.2f} & {pt:.2f} & {np.rad2deg(qt):.2f} & "
                    f"{'yes' if a else 'no'} & {'yes' if b else 'no'}")
    (OUT / "s5_rows.tex").write_text(" \\\\\n".join(rows))
    i = int(np.argmax(r.utilization)); put("s5_max_util", r.utilization[i], "{:.1f}"); put("s5_max_util_dir", r.directions_deg[i], "{:.0f}")
    j = int(np.argmin(r.utilization)); put("s5_min_util", r.utilization[j], "{:.1f}"); put("s5_min_util_dir", r.directions_deg[j], "{:.0f}")
    put("s5_n_lf_masked", int((~ok_lf).sum()), "{:d}"); put("s5_n_tot_masked", int((~ok_tot).sum()), "{:d}")
    put("s5_masked_lf_dirs", ", ".join(f"{d:.0f}" for d in r.directions_deg[~ok_lf]) or "none")
    put("s5_masked_tot_dirs", ", ".join(f"{d:.0f}" for d in r.directions_deg[~ok_tot]) or "none")
    put("s5_n_dirs", len(r.directions_deg), "{:d}")
    return r


def sim6():
    kind = rc.selected_observer()
    cfg = Part2SimConfig(dt=DT, T=1000.0, use_observer=True, observer_type=kind)
    heavy = rc.run(cfg, np.zeros(6), env(hs=rc.ROBUST_HS, tp=rc.ROBUST_TP))
    cfg2 = Part2SimConfig(dt=DT, T=1000.0, use_observer=True, observer_type=kind)
    design = rc.run(cfg2, np.zeros(6), env())
    win = lambda l: sel(l, 700.0, 1000.0)   # 300 s window = the length used in the design-sea runs (Sim. 4 stage 3, Sim. 5)
    for tag, l in (("heavy", heavy), ("design", design)):
        w = win(l)
        put(f"s6_{tag}_rms_pos", rms(pos_err(l)[w])); put(f"s6_{tag}_max_pos", pos_err(l)[w].max())
        put(f"s6_{tag}_rms_psi", np.rad2deg(rms(psi_err(l)[w])))
        for k, v in est_errors(l, w).items(): put(f"s6_{tag}_{k}", v, "{:.3f}")
        for k, v in activity(l, w).items(): put(f"s6_{tag}_{k}", v)
        cr = constraint_report(l)
        for nm, v in cr.items(): put(f"s6_{tag}_{nm}_atmax", 100 * v[0], "{:.1f}"); put(f"s6_{tag}_{nm}_atrate", 100 * v[1], "{:.1f}")
        r = l.tau_d - l.tau_thr; put(f"s6_{tag}_res_rms", rms(r[w][:, :2]) / 1e3)
        put(f"s6_{tag}_full_max_pos", pos_err(l).max()); put(f"s6_{tag}_full_rms_pos", rms(pos_err(l)))
    save(plot_observer(heavy), "p2_sim6_observer.png"); save(plot_observer_error(heavy), "p2_sim6_observer_err.png")
    save(plot_thruster_setpoints(heavy), "p2_sim6_thrust.png")
    f, ax = plt.subplots(2, 1, figsize=(9, 5), sharex=True)
    for l, lab in ((design, "design sea $H_s$=1.5 m, $T_p$=8 s"), (heavy, "heavy sea $H_s$=2.5 m, $T_p$=10 s")):
        ax[0].plot(l.t, pos_err(l), label=lab); ax[1].plot(l.t, np.sum(np.abs(l.u), axis=1) / 1e3)
    ax[0].axvspan(700, 1000, color="0.9"); ax[0].set_ylabel("position error [m]"); ax[1].set_ylabel("$\\sum|u_i|$ [kN]")
    ax[1].set_xlabel("time [s]"); ax[0].legend(); [a.grid(alpha=.3) for a in ax]; f.tight_layout(); save(f, "p2_sim6_compare.png")
    return heavy, design


def sim7():
    """Own test: wave-period mismatch.  The NPO notch is fixed at w0 = 2 pi/8; the sea Tp is varied."""
    tps = [6.0, 8.0, 10.0, 12.0]
    out = {}
    for kind, nm in (("nonlinear_passive", "npo"), ("kalman", "ekf")):
        for tp in tps:
            cfg = Part2SimConfig(dt=DT, T=900.0, use_observer=True, observer_type=kind)
            l = rc.run(cfg, np.zeros(6), env(tp=tp))
            w = sel(l, 300.0)
            e = est_errors(l, w); a = activity(l, w)
            out[(nm, tp)] = (rms(pos_err(l)[w]), e["wf"], a["rms_du"], e["pos"], e["vel"])
            for k, v in zip(("pos", "wf", "du", "epos", "evel"), out[(nm, tp)]): put(f"s7_{nm}_tp{int(tp)}_{k}", v, "{:.3f}")
    f, ax = plt.subplots(1, 3, figsize=(12, 3.8))
    for nm, c in (("npo", "C1"), ("ekf", "C2")):
        ax[0].plot(tps, [out[(nm, t)][0] for t in tps], "-o", color=c, label=nm.upper())
        ax[1].plot(tps, [out[(nm, t)][1] for t in tps], "-o", color=c)
        ax[2].plot(tps, [out[(nm, t)][2] for t in tps], "-o", color=c)
    ax[0].set_ylabel("RMS position error [m]"); ax[1].set_ylabel("WF residual in $\\hat N$ / measured [-]")
    ax[2].set_ylabel("RMS thrust rate [kN/s]")
    for a in ax: a.set_xlabel("peak period $T_p$ [s]"); a.axvline(8, color="gray", ls=":"); a.grid(alpha=.3)
    ax[0].legend(); f.tight_layout(); save(f, "p2_sim7.png")
    return out


def bonus():
    fixed = rc.WrenchSequence([(1.0, [2e3, 2e3, 2e3])])
    for kind, nm in (("nonlinear_passive", "npo"), ("kalman", "ekf")):
        cfg = Part2SimConfig(dt=DT, T=600.0, use_reference=False, use_observer=True, observer_type=kind, use_sensor_noise=True)
        l = rc.run(cfg, np.zeros(6), env(), controller=fixed)
        save(plot_observer_error(l), f"p2_bonus_{nm}_err.png")
        for k, v in est_errors(l, sel(l, 300.0)).items(): put(f"bn_{nm}_{k}", v, "{:.3f}")
    cl = {}
    for label, use, kind in (("raw", False, rc.selected_observer()), ("sel", True, rc.selected_observer())):
        cfg = Part2SimConfig(dt=DT, T=600.0, use_observer=use, observer_type=kind, use_sensor_noise=True)
        l = rc.run(cfg, np.zeros(6), env()); cl[label] = l; s = sel(l, 300.0)
        put(f"bnc_{label}_rms_pos", rms(pos_err(l)[s])); put(f"bnc_{label}_rms_psi", np.rad2deg(rms(psi_err(l)[s])))
        for k, v in activity(l, s).items(): put(f"bnc_{label}_{k}", v)
    f, ax = plt.subplots(2, 1, figsize=(9, 5), sharex=True)
    for lab, c in (("raw", "C0"), ("sel", "C2")):
        ax[0].plot(cl[lab].t, pos_err(cl[lab]), color=c, label=lab); ax[1].plot(cl[lab].t, np.sum(np.abs(cl[lab].u), axis=1) / 1e3, color=c, lw=.8)
    ax[0].set_ylabel("position error [m]"); ax[1].set_ylabel("$\\sum|u_i|$ [kN]"); ax[1].set_xlabel("time [s]"); ax[0].legend()
    [a.grid(alpha=.3) for a in ax]; f.tight_layout(); save(f, "p2_bonus.png")


def write_macros():
    lines = ["% generated by make_report_results.py -- do not edit"]
    for k, v in MACROS.items():
        name = "res@" + k
        lines.append("\\expandafter\\gdef\\csname %s\\endcsname{%s}" % (name, v))
    (OUT / "results_macros.tex").write_text("\n".join(lines) + "\n")


def main(argv):
    global OUT
    args = list(argv)
    if "--out" in args:
        i = args.index("--out"); OUT = Path(args[i + 1]); del args[i:i + 2]
    todo = args or ["all"]
    if "all" in todo:
        todo = ["sim1", "sim2", "sim3", "sim4", "sim5", "sim6", "sim7"] + [t for t in todo if t == "bonus"]
    OUT.mkdir(parents=True, exist_ok=True)
    l2 = None
    for name in todo:
        print(f"== {name}", flush=True)
        if name == "sim2": l2 = sim2()
        elif name == "sim3": sim3(l2)
        else: globals()[name]()
        write_macros()
    print(f"done; figures in {OUT/'Resources'}, numbers in {OUT/'results_macros.tex'}")


if __name__ == "__main__":
    main(sys.argv[1:])
