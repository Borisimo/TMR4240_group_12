def sim3(l2=None):
    hold = 300.0
    cfg = Part2SimConfig(dt=DT, T=5 * hold, use_observer=False)
    l = rc.run(cfg, rc.four_corner_commands(cfg, hold), env())
    save(fourcorner_fig(l), "p2_sim3_raw.png")
