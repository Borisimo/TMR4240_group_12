def sim2():
    hold = 300.0
    cfg = Part2SimConfig(dt=DT, T=5 * hold, use_observer=False, thruster_dynamics=True)
    l = rc.run(cfg, rc.four_corner_commands(cfg, hold), env(current=False, wind=False, waves=False))
    save(fourcorner_fig(l), "p2_sim2_fourcorner.png")
    save(plot_thruster_setpoints(l), "p2_sim2_thrusters.png")
    save(plot_wrench_residual(l), "p2_sim2_residual.png")
    save(velocity_fig(l), "p2_sim2_velocity.png")
    from simulation.plotter import plot_wrench
    save(plot_wrench(l), "p2_sim2_wrench.png")
    for k, (p, h) in enumerate(leg_table(l)):
        put(f"s2_leg{k+1}_pos", p); put(f"s2_leg{k+1}_psi", h)
    r = l.tau_d - l.tau_thr
    for nm, i in (("X", 0), ("Y", 1), ("N", 5)):
