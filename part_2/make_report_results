# ------------------------------------------------------------------ metrics
def pos_err(l):  return np.hypot(l.eta[:, 0] - l.sp[:, 0], l.eta[:, 1] - l.sp[:, 1])
def psi_err(l):  return np.abs((l.eta[:, 5] - l.sp[:, 5] + np.pi) % (2 * np.pi) - np.pi)
def sel(l, t0, t1=None): return (l.t >= t0) & (l.t <= (l.t[-1] if t1 is None else t1))
def rms(x): return float(np.sqrt(np.mean(np.square(x))))


def activity(l, window):
    """RMS thrust [kN], RMS thrust rate [kN/s], total azimuth travel [deg], mean utilisation [%]."""
    s = window
    dt = l.t[1] - l.t[0]
    du = np.diff(l.u, axis=0) / dt
    da = np.abs(np.diff(np.unwrap(l.alpha[:, 1:], axis=0), axis=0))
    return dict(rms_u=rms(l.u[s] / 1e3), rms_du=rms(du[s[1:]] / 1e3),
                az=float(np.rad2deg(da[s[1:]].sum())),
                util=float(np.mean(thrust_utilization(l, TH)[s])))


def estimate_lag(est, truth, dt, window, max_lag=30.0):
    """Lag [s] of an estimate behind the low-frequency truth: the shift that minimises the RMS difference."""
    idx = np.where(window)[0]
    best, best_e = 0, np.inf
    for k in range(0, int(max_lag / dt) + 1):
        i = idx[idx + k < len(est)]
        e = rms(est[i + k] - truth[i])
        if e < best_e:
            best, best_e = k, e
    return best * dt


def est_errors(l, window):
    """RMS errors of the estimate relative to the LF truth (30 s moving average of the true pose)."""
    lf_true = low_frequency_motion(l, 30.0) if hasattr(l, "eta") else None
    e_pos = np.hypot(l.eta_est[:, 0] - lf_true[:, 0], l.eta_est[:, 1] - lf_true[:, 1])
    e_psi = np.abs((l.eta_est[:, 5] - lf_true[:, 2] + np.pi) % (2 * np.pi) - np.pi)
    e_vel = np.hypot(l.nu_est[:, 0] - l.nu[:, 0], l.nu_est[:, 1] - l.nu[:, 1])
    e_r = np.abs(l.nu_est[:, 5] - l.nu[:, 5])
    # raw measurement noise passed on: RMS of the estimate rate of change (smoothness)
    dt = l.t[1] - l.t[0]
    smooth = np.hypot(np.diff(l.eta_est[:, 0]), np.diff(l.eta_est[:, 1])) / dt
    return dict(pos=rms(e_pos[window]), psi=float(np.rad2deg(rms(e_psi[window]))),
                vel=rms(e_vel[window]), r=float(np.rad2deg(rms(e_r[window]))),
                smooth=rms(smooth[window[1:]]),
                lag=0.5 * (estimate_lag(l.eta_est[:, 0], lf_true[:, 0], l.t[1] - l.t[0], window)
                           + estimate_lag(l.eta_est[:, 1], lf_true[:, 1], l.t[1] - l.t[0], window)),
                wf=rms((l.eta_est[:, 0] - lf_true[:, 0])[window]) / max(rms((l.eta_measured[:, 0] - lf_true[:, 0])[window]), 1e-9))


# ------------------------------------------------------------- plot helpers
def ts_fig(l, title=None, ref=True):
    fig, ax = plt.subplots(3, 1, figsize=(8, 7), sharex=True)
    lab = [("North [m]", 0, 1.0), ("East [m]", 1, 1.0), ("Heading [deg]", 5, np.rad2deg(1))]
    for a, (yl, i, sc) in zip(ax, lab):
        a.plot(l.t, l.eta[:, i] * sc, label="actual")
        a.plot(l.t, l.sp[:, i] * sc, "--", label="reference $\\eta_d$")
        if i == 5:
            a.plot(l.t, l.cmd[:, i] * sc, ":", color="gray", label="set-point")
        else:
            a.plot(l.t, l.cmd[:, i] * sc, ":", color="gray", label="set-point")
        a.set_ylabel(yl); a.grid(alpha=.3)
    ax[0].legend(ncol=3, fontsize=8); ax[-1].set_xlabel("time [s]")
    if title: fig.suptitle(title)
    fig.tight_layout(); return fig


def fourcorner_fig(l):
    fig = plt.figure(figsize=(12, 7))
    gs = fig.add_gridspec(3, 2, width_ratios=[1, 1.3])
    ax = fig.add_subplot(gs[:, 0])
    ax.plot(l.eta[:, 1], l.eta[:, 0], label="actual")
    ax.plot(l.sp[:, 1], l.sp[:, 0], "--", label="reference")
    for k in range(0, len(l.t), int(150 / DT)):
        ax.arrow(l.eta[k, 1], l.eta[k, 0], 4 * np.sin(l.eta[k, 5]), 4 * np.cos(l.eta[k, 5]),
                 head_width=1.5, color="k")
    ax.set_xlabel("East [m]"); ax.set_ylabel("North [m]"); ax.axis("equal"); ax.grid(alpha=.3); ax.legend()
    for j, (yl, i, sc) in enumerate([("N [m]", 0, 1), ("E [m]", 1, 1), ("$\\psi$ [deg]", 5, np.rad2deg(1))]):
        a = fig.add_subplot(gs[j, 1]); a.plot(l.t, l.eta[:, i] * sc); a.plot(l.t, l.sp[:, i] * sc, "--")
        a.plot(l.t, l.cmd[:, i] * sc, ":", color="gray"); a.set_ylabel(yl); a.grid(alpha=.3)
    a.set_xlabel("time [s]"); fig.tight_layout(); return fig


def velocity_fig(l):
    fig, ax = plt.subplots(3, 1, figsize=(8, 6), sharex=True)
    for a, (yl, i) in zip(ax, [("u [m/s]", 0), ("v [m/s]", 1), ("r [rad/s]", 5)]):
        a.plot(l.t, l.nu[:, i], label="actual"); a.plot(l.t, l.nu_ref[:, i], "--", label="reference")
        a.set_ylabel(yl); a.grid(alpha=.3)
    ax[0].legend(); ax[-1].set_xlabel("time [s]"); fig.tight_layout(); return fig


def leg_table(l, hold=300.0):
    """Mean position / heading error over the last 50 s of each leg."""
    out = []
    for k in range(5):
        s = sel(l, (k + 1) * hold - 50.0, (k + 1) * hold)
        out.append((float(pos_err(l)[s].mean()), float(np.rad2deg(psi_err(l)[s].mean()))))
    return out


def constraint_report(l, tol=1e-6):
    """Fraction of time each actuator limit is active (actual at a bound / moving at its rate limit)."""
    dt = l.t[1] - l.t[0]
    res = {}
    for i, th in enumerate(TH):
        at_max = np.mean(np.abs(l.u[:, i]) >= th.u_max - 1.0)
        du = np.abs(np.diff(l.u[:, i])) / dt
        at_rate = np.mean(du >= th.u_rate - 1.0)
        res[th.name] = (float(at_max), float(at_rate))
        if th.rot_speed > 0:
            da = np.abs(np.diff(np.unwrap(l.alpha[:, i]))) / dt
            res[th.name] += (float(np.mean(da >= th.rot_speed - 1e-4)),)
    return res


