def put(key: str, value, fmt: str = "{:.2f}"):
    MACROS[key] = fmt.format(value) if not isinstance(value, str) else value


def save(fig, name: str):
    (OUT / "Resources").mkdir(parents=True, exist_ok=True)
    fig.savefig(OUT / "Resources" / name, dpi=170, bbox_inches="tight")
    plt.close(fig)


def env(**kw):
