    save(plot_wrench_residual(l), "p2_sim3_residual.png")
    f = plt.figure(figsize=(10, 6)); ax = f.subplots(3, 1, sharex=True)
    for a, (n, i) in zip(ax, [("X", 0), ("Y", 1), ("N", 5)]):
        a.plot(l.t, l.tau_w6[:, i] / 1e3, label="wind"); a.plot(l.t, l.tau_wave[:, i] / 1e3, label="waves", lw=.7)
        a.set_ylabel(f"{n} [kN]"); a.grid(alpha=.3)
